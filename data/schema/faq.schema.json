{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAQ",
  "description": "Frequently asked questions.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        }
      }
    }
  },
  "required": [
    "version",
    "updated",
    "items"
  ]
}
