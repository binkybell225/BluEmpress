{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tester guide",
  "description": "Steps and feedback guidance for testers.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "title",
          "detail"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "feedbackWanted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "version",
    "updated",
    "title",
    "steps"
  ]
}
