{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Features and roadmap",
  "description": "Feature list and idea status.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "app": {
      "type": "object"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "statuses": {
      "type": "array",
      "items": {
        "enum": [
          "live",
          "testing",
          "idea"
        ]
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "status": {
            "enum": [
              "live",
              "testing",
              "idea"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  },
  "required": [
    "version",
    "updated",
    "features"
  ]
}
