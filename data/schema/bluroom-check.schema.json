{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BluRoom Check lines",
  "description": "Lines BluEmpress says during a BluRoom Check.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "triggerChance": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^bc-\\d{3,}$"
          },
          "text": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "live",
              "suggested"
            ]
          }
        }
      }
    },
    "styleRules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "version",
    "updated",
    "lines"
  ]
}
